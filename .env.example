# Copy this file to .env and fill in real values before running.

# SQLite for local dev (zero setup). Swap for Postgres when ready:
# DATABASE_URL=postgresql://user:password@localhost:5432/rungline
DATABASE_URL=sqlite:///./rungline.db

# Judge0 — get a free key at https://rapidapi.com/judge0-official/api/judge0-ce
# (or point this at a self-hosted Judge0 instance's URL instead)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
